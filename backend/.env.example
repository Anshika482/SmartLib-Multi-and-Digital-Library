# ===========================================================================
#  Environment template for the production profile
# ===========================================================================
#  Copy to backend/.env - which git ignores - and fill in the blanks. Never
#  commit a filled-in copy. Used with:
#
#      docker run --env-file backend/.env ...
#
#  Write values without quotes: --env-file passes them literally. A required
#  value left blank stops the application at startup, on purpose. See
#  README.md for what each variable does.
# ===========================================================================

# ---- Required -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod

# JDBC URL of an existing database. TLS must be required (sslMode=REQUIRED,
# VERIFY_CA or VERIFY_IDENTITY); no credentials in the URL.
DB_URL=jdbc:mysql://db.example.invalid:3306/library_db?sslMode=VERIFY_IDENTITY

# A dedicated account with rights to create and alter tables in that database.
DB_USERNAME=
DB_PASSWORD=

# At least 32 bytes of private, random text.
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=

# Where password reset links are sent from and where they point. Required
# under the prod profile: without them a reset is issued and never delivered,
# so the application refuses to start. MAIL_FROM may be left blank when
# MAIL_USERNAME is the sending address.
MAIL_HOST=smtp.example.invalid
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=library@example.invalid
APP_RESET_LINK_BASE_URL=https://library.example.invalid/reset-password

# Razorpay merchant credentials, for paying fines by card. Both are required
# under the prod profile, which also requires PAYMENT_GATEWAY_PROVIDER=razorpay
# and refuses to start on the sandbox gateway. In development, both blank means
# online payment is refused with 503 and fines are recorded at the desk
# instead. The key id is public and goes to the browser; the secret verifies
# the provider's signature and must never be published or committed. No card
# data is ever received or stored by this application.
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=

# ---- Optional (defaults shown) --------------------------------------------
# The JVM must run in this zone; the Docker image pins Asia/Kolkata.
APP_TIME_ZONE=Asia/Kolkata

# Comma-separated exact browser origins, such as https://library.example.invalid.
CORS_ALLOWED_ORIGINS=

FINE_DAILY_RATE=1.00
JWT_ACCESS_TOKEN_VALIDITY=PT1H
JWT_REFRESH_TOKEN_VALIDITY=P7D

# How long ended sessions stay in the database, and how often they are swept
# away. Retention must be at least JWT_REFRESH_TOKEN_VALIDITY.
JWT_REFRESH_TOKEN_RETENTION=P30D
JWT_REFRESH_TOKEN_CLEANUP_INTERVAL=PT1H

# How long a self-service password reset token works; at most PT24H. Spent
# tokens are kept for the retention, then swept away every cleanup interval.
PASSWORD_RESET_TOKEN_VALIDITY=PT30M
PASSWORD_RESET_TOKEN_RETENTION=P1D
PASSWORD_RESET_TOKEN_CLEANUP_INTERVAL=PT1H

# The SMTP submission port, and whether to upgrade the connection to TLS. The
# link is a credential while it lasts, so STARTTLS is on unless turned off.
MAIL_PORT=587
MAIL_STARTTLS=true

# Which payment provider to use: "razorpay" for the real one, or
# "hmac-sandbox" for local development, where orders are opened in process and
# nothing leaves the machine. An unknown name stops startup. PAYMENT_GATEWAY_BASE_URL
# overrides Razorpay's API host and is needed only to point at a stub.
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_GATEWAY_BASE_URL=https://api.razorpay.com
PAYMENT_CURRENCY=INR

# How long to wait for Razorpay when opening an order. ISO-8601 durations;
# zero or less stops the application at startup.
PAYMENT_GATEWAY_CONNECT_TIMEOUT=PT3S
PAYMENT_GATEWAY_READ_TIMEOUT=PT8S

# Which assistant answers POST /api/chat: "gemini", "anthropic", or "scripted".
# A provider and its own key are both required under the prod profile, which
# refuses the scripted assistant: it answers from a keyword list, and a
# deployment left on it has an assistant in name only. In development the
# default is "scripted", which calls no provider and needs no key. An unknown
# name stops startup anywhere, as does naming one provider while setting only
# the other's key.
#
# Set the key for the provider you name; the other can stay blank. Both keys
# are secrets: never commit either, and note that each is read once into its
# SDK client and is never logged, stored or returned.
CHAT_PROVIDER=gemini

# Gemini, through Google's Gen AI SDK. GEMINI_MODEL may be left unset, in which
# case a current stable Flash model is used.
#
# GEMINI_THINKING_LEVEL is the setting that decides how long a caller waits:
# thinking tokens are produced before any of the answer. Which values a model
# accepts differs and the sets do not overlap - gemini-3.8-flash takes low,
# medium and high, the -flash-lite models take minimal and high - so these two
# variables move together. An unrecognised level stops startup; a level the
# model will not serve is refused per request.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal

# Claude, through the Anthropic SDK. Kept configured so a deployment can be
# moved back to it by changing CHAT_PROVIDER alone.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5

# How long the provider is given: opening the connection, waiting for bytes,
# and the whole call including retries. Zero or less stops startup.
CHAT_CONNECT_TIMEOUT=PT5S
CHAT_READ_TIMEOUT=PT30S
CHAT_REQUEST_TIMEOUT=PT45S

# ---- First start only -----------------------------------------------------
# Needed only when the database has no accounts yet: they create the first
# library and its administrator at startup, then are never read again. With
# accounts present they are ignored and may be left blank. The password must be
# 8 to 72 characters; nothing here is ever written to the log.
BOOTSTRAP_ADMIN_LIBRARY=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --------------------------------------------------------------------------
#  Book cover images
# --------------------------------------------------------------------------
# Where cover images are kept. The database stores only an opaque key; the file
# lives here. Give an absolute path on a volume that survives a restart - a
# container's writable layer does not. Blank uses ./data/covers, which is fine
# for development and not for a deployment.
COVERS_DIRECTORY=
# The largest a single cover may be, in bytes. Blank uses 2 MB.
COVERS_MAX_SIZE_BYTES=

# --------------------------------------------------------------------------
#  Notifications
# --------------------------------------------------------------------------
# Event notifications - a book issued, a request approved, a fine receipt - use
# the MAIL_* settings above and need nothing here. With no MAIL_HOST nothing is
# sent and each is recorded as not delivered.
#
# These four are only for the reminder sweep, which is the one thing that
# decides on its own when to write to somebody.

# Whether to remind people about books due soon and overdue. Blank enables it.
# Set to false on a developer's machine, or on a deployment that has not settled
# its wording yet.
NOTIFICATION_REMINDERS_ENABLED=
# How often the sweep runs, as an ISO-8601 duration. Blank uses PT6H. The sweep
# is idempotent, so this changes how soon somebody hears rather than how much
# they receive.
NOTIFICATION_REMINDERS_INTERVAL=
# How many days ahead of its due date a loan counts as due soon. Blank uses 3.
NOTIFICATION_REMINDERS_DUE_SOON_DAYS=
# The most loans one pass considers, of each kind. Blank uses 200.
NOTIFICATION_REMINDERS_BATCH_SIZE=
