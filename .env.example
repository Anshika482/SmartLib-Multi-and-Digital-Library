# Copy to .env and fill in. Never commit .env.
# --- Database (MySQL 8). Prefixed with SMARTLIB_ so they never collide with other projects' DB_* variables ---
SMARTLIB_DB_URL=jdbc:mysql://localhost:3306/smartlib?serverTimezone=UTC&characterEncoding=utf8
SMARTLIB_TEST_DB_URL=jdbc:mysql://localhost:3306/smartlib_test?serverTimezone=UTC&characterEncoding=utf8
SMARTLIB_DB_USERNAME=smartlib
SMARTLIB_DB_PASSWORD=change-me
# --- Security ---
# At least 32 random bytes, base64. e.g. python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(48)).decode())"
JWT_SECRET=
# Random string used to HMAC one-time codes (OTP) before storing them.
APP_TOKEN_PEPPER=
# true in production (HTTPS)
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# --- Email ---
# Option A (default): Mailpit catches every email locally (SMTP localhost:1025, inbox at http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@smartlib.local
# Option B: real inboxes through Gmail. Turn on 2-Step Verification, create an App Password
# (Google Account > Security > App passwords) and replace the seven lines above with:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your.address@gmail.com
#   MAIL_PASSWORD=<16-character app password>
#   MAIL_SMTP_AUTH=true
#   MAIL_STARTTLS=true
#   MAIL_FROM=your.address@gmail.com
# With a real provider, demo/test addresses (@smartlib.demo, .test, .example) are skipped instead of bouncing.
# --- Google Gemini ---
GEMINI_API_KEY=
# gemini-flash-lite-latest answers fastest (first words in ~1 s); larger models are slower.
GEMINI_MODEL=gemini-flash-lite-latest
# --- Razorpay (use test-mode keys) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# true = without Razorpay keys, "Pay now" uses SmartLib's built-in demo gateway (labelled demo, no real money, same
# server-side signature check). Real Razorpay keys always take priority. Set to false for production.
PAYMENTS_DEMO_MODE=false
# --- Files ---
STORAGE_DIR=./storage
# --- Demo data (clearly-marked demo libraries/books/users for development & viva) ---
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=
# true = the login page offers one-click demo accounts (Member, Librarian, Admin, Super Admin) with the
# password above, so anyone can explore. Set to false for production.
DEMO_LOGIN_ENABLED=false
# --- One-time SUPER_ADMIN bootstrap (used only if no SUPER_ADMIN exists) ---
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=Platform Administrator
