# Where the API lives for a built deployment. Left unset in development, where
# the Vite dev server proxies /api to the backend and the browser sees one
# origin. A deployed value must also appear in the backend's
# CORS_ALLOWED_ORIGINS, or the browser will refuse the response.
VITE_API_BASE_URL=

# Which backend the dev server proxies to. Defaults to http://localhost:8080.
VITE_DEV_API_TARGET=http://localhost:8080
